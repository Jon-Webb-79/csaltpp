<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>assert(reinterpret_cast&lt;uintptr_t&gt;(ptr)<sp/>%<sp/>64<sp/>==<sp/>0);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>Can<sp/>safely<sp/>use<sp/>SIMD<sp/>instructions</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>float*<sp/>data<sp/>=<sp/>static_cast&lt;float*&gt;(ptr);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>...<sp/>perform<sp/>SIMD<sp/>operations<sp/>...</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>allocator.return_element(ptr,<sp/>512,<sp/>64);</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting> <programlisting filename="Aligned"></programlisting> </para>
