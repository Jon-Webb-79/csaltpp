  <compounddef id="Getting-example" kind="example">
    <compoundname>Getting</compoundname>
    <briefdescription>
<para>statistics </para>
    </briefdescription>
    <detaileddescription>
<para>statistics <programlisting><codeline><highlight class="normal">{.c++}<sp/></highlight></codeline>
<codeline><highlight class="normal"><ref refid="classcslt_1_1HeapAllocator" kindref="compound">cslt::HeapAllocator</ref><sp/>allocator(32);<sp/><sp/></highlight><highlight class="comment">//<sp/>32-byte<sp/>default<sp/>alignment</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordtype">char</highlight><highlight class="normal"><sp/>buffer[512];</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(allocator.stats(buffer,<sp/></highlight><highlight class="keyword">sizeof</highlight><highlight class="normal">(buffer)))<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>printf(</highlight><highlight class="stringliteral">&quot;%s\n&quot;</highlight><highlight class="normal">,<sp/>buffer);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>Outputs<sp/>allocator<sp/>type,<sp/>alignment,<sp/>and<sp/>capabilities</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<sect3 id="/home/jonwebb/Code_Dev/C++/csaltpp/csaltpp/include/allocator.hpp_1autotoc_md0">
<title>Always match allocation and deallocation:</title>
<para><programlisting><codeline><highlight class="comment">//<sp/>CORRECT</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>r<sp/>=<sp/>allocator.alloc_aligned(512,<sp/>64,<sp/></highlight><highlight class="keyword">false</highlight><highlight class="normal">);</highlight></codeline>
<codeline><highlight class="normal">allocator.return_element(r.value(),<sp/>512,<sp/>64);<sp/><sp/></highlight><highlight class="comment">//<sp/>Same<sp/>alignment!</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="comment">//<sp/>INCORRECT<sp/>-<sp/>mismatched<sp/>alignment</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>r<sp/>=<sp/>allocator.alloc_aligned(512,<sp/>64,<sp/></highlight><highlight class="keyword">false</highlight><highlight class="normal">);</highlight></codeline>
<codeline><highlight class="normal">allocator.return_element(r.value(),<sp/>512,<sp/>16);<sp/><sp/></highlight><highlight class="comment">//<sp/>Wrong!<sp/>Undefined<sp/>behavior!</highlight></codeline>
</programlisting></para>
</sect3>
<sect3 id="/home/jonwebb/Code_Dev/C++/csaltpp/csaltpp/include/allocator.hpp_1autotoc_md1">
<title>Check return values:</title>
<para><programlisting><codeline><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>result<sp/>=<sp/>allocator.alloc(1024,<sp/></highlight><highlight class="keyword">false</highlight><highlight class="normal">);</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(result.hasValue())<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>Safe<sp/>to<sp/>use<sp/>result.value()</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">}<sp/></highlight><highlight class="keywordflow">else</highlight><highlight class="normal"><sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>Handle<sp/>allocation<sp/>failure</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
</sect3>
<sect3 id="/home/jonwebb/Code_Dev/C++/csaltpp/csaltpp/include/allocator.hpp_1autotoc_md2">
<title>Clean up before destruction:</title>
<para><programlisting><codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><ref refid="classcslt_1_1HeapAllocator" kindref="compound">cslt::HeapAllocator</ref><sp/>allocator;</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>result<sp/>=<sp/>allocator.<ref refid="classcslt_1_1HeapAllocator_1a11de81a6f52b82e6578b69332482735d" kindref="member">alloc</ref>(1024,<sp/></highlight><highlight class="keyword">false</highlight><highlight class="normal">);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>...<sp/>use<sp/>memory<sp/>...</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>MUST<sp/>free<sp/>before<sp/>allocator<sp/>is<sp/>destroyed</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>allocator.<ref refid="classcslt_1_1HeapAllocator_1aee2691eca10efc6a09848cfcdcec9c2c" kindref="member">return_element</ref>(result.value(),<sp/>1024,<sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>allocator.<ref refid="classcslt_1_1Allocator_1a5efa5aa5b36cca23c9bb94f5ba2756d0" kindref="member">default_alignment</ref>());</highlight></codeline>
<codeline><highlight class="normal">}<sp/></highlight><highlight class="comment">//<sp/>Safe<sp/>-<sp/>all<sp/>memory<sp/>freed</highlight></codeline>
</programlisting></para>
<para><simplesect kind="note"><para>This class is only available when ARENA_ENABLE_DYNAMIC is enabled. Define STATIC_ONLY to disable dynamic allocation for MISRA compliance.</para>
</simplesect>
<simplesect kind="warning"><para>HeapAllocator does not track memory usage. Methods like size(), remaining(), and is_ptr() will return default values (0/false).</para>
</simplesect>
<simplesect kind="warning"><para>After calling realloc() or realloc_aligned(), the original pointer is invalid and must not be used. Always use the newly returned pointer.</para>
</simplesect>
<simplesect kind="warning"><para>Always use the same alignment value for return_element() that was used during allocation. Mismatched alignment causes undefined behavior.</para>
</simplesect>
<simplesect kind="see"><para>Allocator Base class interface with full method documentation </para>
</simplesect>
<simplesect kind="see"><para>ArenaAllocator For memory tracking and fixed capacity allocations </para>
</simplesect>
<simplesect kind="see"><para>PoolAllocator For fixed-size object allocation <programlisting filename="Getting"></programlisting> </para>
</simplesect>
</para>
</sect3>
