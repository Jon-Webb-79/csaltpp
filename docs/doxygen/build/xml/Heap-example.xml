    <detaileddescription>
<para>buffer arena <programlisting><codeline><highlight class="normal">uint8_t*<sp/>buffer<sp/>=<sp/>new<sp/>uint8_t[65536];</highlight></codeline>
<codeline><highlight class="normal">auto<sp/>result<sp/>=<sp/>cslt::ArenaAllocator::Stack(buffer,<sp/>65536,<sp/>32);</highlight></codeline>
<codeline><highlight class="normal">auto<sp/>arena<sp/>=<sp/>cslt::move(result.value());</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">//<sp/>Use<sp/>arena...</highlight></codeline>
<codeline><highlight class="normal">auto<sp/>ptr<sp/>=<sp/>arena-&gt;alloc(1024);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">//<sp/>Arena<sp/>destroyed<sp/>first</highlight></codeline>
<codeline><highlight class="normal">arena.reset();</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">//<sp/>Now<sp/>safe<sp/>to<sp/>free<sp/>buffer</highlight></codeline>
<codeline><highlight class="normal">delete[]<sp/>buffer;</highlight></codeline>
</programlisting></para>
