<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keywordtype">void</highlight><highlight class="normal">*<sp/>ptr<sp/>=<sp/>result.<ref refid="classcslt_1_1Expected_1a5d4e95808d25a88c3e7b2935a654f92f" kindref="member">value</ref>();</highlight></codeline>
