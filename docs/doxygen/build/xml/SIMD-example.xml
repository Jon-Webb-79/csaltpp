  <compounddef id="SIMD-example" kind="example">
    <compoundname>SIMD</compoundname>
    <briefdescription>
<para>alignment (256-bit AVX) </para>
    </briefdescription>
    <detaileddescription>
<para>alignment (256-bit AVX) <programlisting><codeline><highlight class="normal"><ref refid="classcslt_1_1HeapAllocator" kindref="compound">cslt::HeapAllocator</ref><sp/>allocator;</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="comment">//<sp/>Allocate<sp/>aligned<sp/>for<sp/>AVX<sp/>operations</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>result<sp/>=<sp/>allocator.<ref refid="classcslt_1_1HeapAllocator_1a53a1b9b301c70c4ce6035075385317e7" kindref="member">alloc_aligned</ref>(1024,<sp/>32,<sp/></highlight><highlight class="keyword">true</highlight><highlight class="normal">);</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(result.hasValue())<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keywordtype">float</highlight><highlight class="normal">*<sp/>data<sp/>=<sp/></highlight><highlight class="keyword">static_cast&lt;</highlight><highlight class="keywordtype">float</highlight><highlight class="normal">*</highlight><highlight class="keyword">&gt;</highlight><highlight class="normal">(result.value());</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>Can<sp/>safely<sp/>use<sp/>AVX<sp/>instructions</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>allocator.<ref refid="classcslt_1_1HeapAllocator_1aee2691eca10efc6a09848cfcdcec9c2c" kindref="member">return_element</ref>(data,<sp/>1024,<sp/>32);</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="warning"><para>The alignment parameter to return_element() must match the alignment used for allocation.</para>
</simplesect>
<simplesect kind="see"><para>alloc() For standard alignment </para>
</simplesect>
<simplesect kind="see"><para>return_element() To free aligned memory <programlisting filename="SIMD"></programlisting> </para>
</simplesect>
</para>
