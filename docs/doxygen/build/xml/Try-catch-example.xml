<doxygen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="compound.xsd" version="1.9.1" xml:lang="en-US">
  <compounddef id="Try-catch-example" kind="example">
    <compoundname>Try-catch</compoundname>
    <briefdescription>
<para>pattern </para>
    </briefdescription>
    <detaileddescription>
<para>pattern <programlisting><codeline><highlight class="normal">auto<sp/>arena<sp/>=<sp/>cslt::move(cslt::ArenaAllocator::Heap(8192).value());</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">void*<sp/>checkpoint<sp/>=<sp/>arena-&gt;save();</highlight></codeline>
<codeline><highlight class="normal">try<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>Make<sp/>allocations<sp/>that<sp/>might<sp/>fail</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>auto<sp/>data1<sp/>=<sp/>arena-&gt;alloc(1024).value();</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>risky_operation(data1);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>auto<sp/>data2<sp/>=<sp/>arena-&gt;alloc(2048).value();</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>risky_operation(data2);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>Success<sp/>-<sp/>keep<sp/>allocations</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>arena-&gt;restore(checkpoint);<sp/><sp/>//<sp/>Must<sp/>free<sp/>checkpoint!</highlight></codeline>
<codeline><highlight class="normal">}<sp/>catch<sp/>(...)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>Failure<sp/>-<sp/>rollback<sp/>allocations</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>arena-&gt;restore(checkpoint);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>throw;</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para>restore() To restore to checkpoint </para>
</simplesect>
<simplesect kind="see"><para>reset() To free all allocations <programlisting filename="Try-catch"></programlisting> </para>
</simplesect>
</para>
    </detaileddescription>
