    <compoundname>Try-catch</compoundname>
    <briefdescription>
<para>pattern </para>
    </briefdescription>
    <detaileddescription>
<para>pattern <programlisting><codeline><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>arena<sp/>=<sp/><ref refid="namespacecslt_1ad55f4168d9f1832627c6d75e60d14a6c" kindref="member">cslt::move</ref>(<ref refid="classcslt_1_1ArenaAllocator_1ab71e5fc5e1cf3e9b07ad7208465a7b0f" kindref="member">cslt::ArenaAllocator::Heap</ref>(8192).value());</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordtype">void</highlight><highlight class="normal">*<sp/>checkpoint<sp/>=<sp/>arena-&gt;save();</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordflow">try</highlight><highlight class="normal"><sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>Make<sp/>allocations<sp/>that<sp/>might<sp/>fail</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>data1<sp/>=<sp/>arena-&gt;alloc(1024).value();</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>risky_operation(data1);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keyword">auto</highlight><highlight class="normal"><sp/>data2<sp/>=<sp/>arena-&gt;alloc(2048).value();</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>risky_operation(data2);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>Success<sp/>-<sp/>keep<sp/>allocations</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>arena-&gt;restore(checkpoint);<sp/><sp/></highlight><highlight class="comment">//<sp/>Must<sp/>free<sp/>checkpoint!</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">}<sp/></highlight><highlight class="keywordflow">catch</highlight><highlight class="normal"><sp/>(...)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>Failure<sp/>-<sp/>rollback<sp/>allocations</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>arena-&gt;restore(checkpoint);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keywordflow">throw</highlight><highlight class="normal">;</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para>restore() To restore to checkpoint </para>
</simplesect>
