<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><ref refid="classcslt_1_1Expected_1a0032c1a667af0b89d6dba16c83a467ce" kindref="member">Expected&lt;int&gt;</ref><sp/><ref refid="classcslt_1_1Expected_1a0032c1a667af0b89d6dba16c83a467ce" kindref="member">result</ref>;</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(<ref refid="classcslt_1_1Expected_1a0032c1a667af0b89d6dba16c83a467ce" kindref="member">b</ref><sp/>==<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><ref refid="classcslt_1_1Expected_1a0032c1a667af0b89d6dba16c83a467ce" kindref="member">result</ref>.setError(DivByZeroError());</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/></highlight><highlight class="keywordflow">return</highlight><highlight class="normal"><sp/><ref refid="classcslt_1_1Expected_1a0032c1a667af0b89d6dba16c83a467ce" kindref="member">result</ref>;</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>}</highlight></codeline>
