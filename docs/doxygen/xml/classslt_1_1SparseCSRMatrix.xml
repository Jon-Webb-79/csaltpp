<codeline><highlight class="normal">coo.set(2,<sp/>1,<sp/>3.0f);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">slt::SparseCSRMatrix&lt;float&gt;<sp/>csr(coo);</highlight></codeline>
